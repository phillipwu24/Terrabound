# ============================================================
# Unreal Engine 5 - .gitattributes
# Solo project. Place this at the repository root
# (same folder as your .uproject file).
#
# IMPORTANT: commit this file BEFORE adding any assets.
# LFS rules only apply to files staged after the rules exist.
# ============================================================

# ------------------------------------------------------------
# Line endings
# Normalize text files; let Git decide what's text by default.
# ------------------------------------------------------------
* text=auto

# Explicit text types (safe from accidental binary detection)
*.cpp        text
*.h          text
*.hpp        text
*.c          text
*.cs         text
*.ini        text
*.txt        text
*.md         text
*.json       text
*.xml        text
*.yml        text
*.yaml       text
*.uproject   text
*.uplugin    text
*.usf        text
*.ush        text
*.py         text
*.sh         text eol=lf
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# ------------------------------------------------------------
# Git LFS - Unreal asset formats
# These are binary, unmergeable, and often large.
# ------------------------------------------------------------
*.uasset     filter=lfs diff=lfs merge=lfs -text
*.umap       filter=lfs diff=lfs merge=lfs -text
*.upk        filter=lfs diff=lfs merge=lfs -text
*.udk        filter=lfs diff=lfs merge=lfs -text
*.ubulk      filter=lfs diff=lfs merge=lfs -text
*.uexp       filter=lfs diff=lfs merge=lfs -text
*.locres     filter=lfs diff=lfs merge=lfs -text

